{
  "name": "per100",
  "private": true,
  "scripts": {
    "ocr:up": "docker compose -f docker-compose.dev.yml up -d --wait ocr-service",
    "ocr:down": "docker compose -f docker-compose.dev.yml down",
    "ocr:build": "docker compose -f docker-compose.dev.yml build ocr-service",
    "lint": "node scripts/venv-run.mjs -m ruff check .",
    "test:ocr": "node scripts/venv-run.mjs -m pytest ocr-service/tests -m \"not real\" -v",
    "verify:ocr": "npm run ocr:up && node scripts/venv-run.mjs -m pytest ocr-service/tests -m real -v",
    "fixtures:capture": "node scripts/venv-run.mjs scripts/capture_fixtures.py",
    "dev:app": "npm --prefix app run dev",
    "dev:up": "docker compose -f docker-compose.dev.yml up -d --wait postgres minio ocr-service",
    "dev:down": "docker compose -f docker-compose.dev.yml down",
    "db:drop": "npm --prefix app run db:drop",
    "db:migrate": "npm --prefix app run db:migrate",
    "db:seed": "npm --prefix app run db:seed",
    "db:reset": "npm run db:drop && npm run db:migrate && npm run db:seed",
    "test": "npm --prefix app run test",
    "test:e2e": "npm --prefix app run test:e2e"
  }
}
