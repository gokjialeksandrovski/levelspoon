{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "cat \"$CLAUDE_PROJECT_DIR/.claude/md-style.md\"",
            "timeout": 10,
            "statusMessage": "Loading markdown style rule..."
          }
        ]
      }
    ]
  }
}
