# OCR service (M1) - mock locally for fast, deterministic dev/test runs;
# must be unset (or explicitly OCR_PROVIDER=real) in any real deployment,
# or every photo silently returns the same canned mock result.
OCR_SERVICE_URL=http://localhost:8000
OCR_PROVIDER=mock

# Database (M2a) - local Postgres by default; swapped to a Neon URL at M5
DATABASE_URL=postgres://levelspoon:levelspoon@localhost:15432/levelspoon

# Auth.js (M2a) - generate a real AUTH_SECRET locally with: npx auth secret
AUTH_SECRET=replace-with-a-real-generated-secret

# Object storage (M2a) - MinIO locally, R2 in production (M5), same client
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=levelspoon
S3_SECRET_ACCESS_KEY=levelspoon_minio
S3_BUCKET=levelspoon-photos
S3_FORCE_PATH_STYLE=true

# Quantity estimation - mock locally for zero AI spend in dev/CI; a real
# Gemini key otherwise.
QUANTITY_PROVIDER=mock

# Lazy-track meal estimation - mock locally for zero AI spend in dev/CI;
# unset (or anything but "mock") calls Gemini with GEMINI_API_KEY below.
MEAL_ESTIMATE_PROVIDER=mock

# Gemini API key (aistudio.google.com), read directly by the Next.js app.
# Set this in app/.env.local - it is no longer passed to a container.
GEMINI_API_KEY=

# Pinned model: an explicit version, never a *-latest alias. Do not use
# gemini-2.5-flash-lite - Google returns 404 "no longer available to new
# users" for API projects created after its retirement.
GEMINI_MODEL=gemini-3.5-flash-lite

# Barcode lookup (spec 2026-09-15-barcode-scanning-design) - mock locally
# for zero network calls in dev/CI; internal product_barcodes table is
# always checked first regardless of this setting, only a miss there
# reaches this provider.
BARCODE_LOOKUP_PROVIDER=mock

# Open Food Facts requires a contact-identifying User-Agent on every
# request (their terms) - set a real address before any real deployment.
OFF_CONTACT_EMAIL=set-a-real-contact-email@levelspoon.example
