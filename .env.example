# OCR service (M1) - mock locally for fast, deterministic dev/test runs;
# must be unset (or explicitly OCR_PROVIDER=real) in any real deployment,
# or every photo silently returns the same canned mock result.
OCR_SERVICE_URL=http://localhost:8000
OCR_PROVIDER=mock

# Database (M2a) - local Postgres by default; swapped to a Neon URL at M5
DATABASE_URL=postgres://per100:per100@localhost:15432/per100

# Auth.js (M2a) - generate a real AUTH_SECRET locally with: npx auth secret
AUTH_SECRET=replace-with-a-real-generated-secret
# Google OAuth client is NOT registered until M4 (spec: no cloud accounts
# before the M2 gate is green). These are placeholders until then - Google
# sign-in will not work locally until M4's real values replace them.
AUTH_GOOGLE_ID=placeholder-until-m4
AUTH_GOOGLE_SECRET=placeholder-until-m4

# Object storage (M2a) - MinIO locally, R2 in production (M5), same client
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=per100
S3_SECRET_ACCESS_KEY=per100_minio
S3_BUCKET=per100-photos
S3_FORCE_PATH_STYLE=true

# Quantity estimation (M2a) - mock locally; a real GEMINI_API_KEY is optional
QUANTITY_PROVIDER=mock
GEMINI_API_KEY=
