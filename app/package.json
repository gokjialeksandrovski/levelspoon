{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:drop": "tsx --env-file=.env.local scripts/drop.ts",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "report:photo-debt": "tsx --env-file=.env.local scripts/photo-debt.ts",
    "check:portion-classes": "tsx scripts/check-portion-classes.ts",
    "fixtures:barcodes": "tsx scripts/generate-barcode-fixtures.ts",
    "test": "vitest run",
    "test:e2e": "playwright test -c playwright.config.ts",
    "test:e2e:real": "playwright test -c playwright.config.real.ts"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@aws-sdk/client-s3": "^3.1165.0",
    "@aws-sdk/s3-request-presigner": "^3.1165.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/postcss": "^4.3.5",
    "any-ascii": "^0.3.3",
    "barcode-detector": "^3.2.3",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "motion": "^14.11.1",
    "next": "^16.4.6",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.1",
    "postcss": "^8.5.32",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.6",
    "eslint-plugin-better-tailwindcss": "^4.11.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "zxing-wasm": "^3.1.6"
  }
}
