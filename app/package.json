{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:drop": "tsx --env-file=.env.local scripts/drop.ts",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "report:photo-debt": "tsx --env-file=.env.local scripts/photo-debt.ts",
    "check:portion-classes": "tsx scripts/check-portion-classes.ts",
    "fixtures:barcodes": "tsx scripts/generate-barcode-fixtures.ts",
    "test": "vitest run",
    "test:e2e": "playwright test -c playwright.config.ts",
    "test:e2e:real": "playwright test -c playwright.config.real.ts"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@aws-sdk/client-s3": "^3.1119.0",
    "@aws-sdk/s3-request-presigner": "^3.1119.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/postcss": "^4.3.3",
    "any-ascii": "^0.3.3",
    "barcode-detector": "^3.2.2",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "motion": "^13.1.1",
    "next": "^16.3.3",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.0",
    "postcss": "^8.5.26",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "^16.3.3",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "zxing-wasm": "^3.1.3"
  }
}
