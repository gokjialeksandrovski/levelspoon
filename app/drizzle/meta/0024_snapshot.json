      "checkConstraints": {
        "user_macro_targets_unit": {
          "name": "user_macro_targets_unit",
          "value": "(\"user\".\"macro_target_unit\" IS NULL) = (num_nonnulls(\"user\".\"macro_protein\", \"user\".\"macro_carbs\", \"user\".\"macro_fat\") = 0)"
        },
        "user_macro_targets_non_negative": {
          "name": "user_macro_targets_non_negative",
          "value": "coalesce(\"user\".\"macro_protein\", 0) >= 0 AND coalesce(\"user\".\"macro_carbs\", 0) >= 0 AND coalesce(\"user\".\"macro_fat\", 0) >= 0"
        },
        "user_macro_targets_pct_whole": {
          "name": "user_macro_targets_pct_whole",
          "value": "\"user\".\"macro_target_unit\" IS DISTINCT FROM 'pct'\n      OR (coalesce(\"user\".\"macro_protein\", 0)::int + coalesce(\"user\".\"macro_carbs\", 0) + coalesce(\"user\".\"macro_fat\", 0) <= 100\n        AND (num_nonnulls(\"user\".\"macro_protein\", \"user\".\"macro_carbs\", \"user\".\"macro_fat\") < 3\n          OR \"user\".\"macro_protein\"::int + \"user\".\"macro_carbs\" + \"user\".\"macro_fat\" = 100))"
        },
        "user_macro_targets_pct_needs_goal": {
          "name": "user_macro_targets_pct_needs_goal",
          "value": "\"user\".\"macro_target_unit\" IS DISTINCT FROM 'pct' OR \"user\".\"daily_calorie_goal\" IS NOT NULL"
        }
      },
